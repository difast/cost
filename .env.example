# PostgreSQL (Timeweb Cloud: управляемая БД PostgreSQL)
DATABASE_URL="postgresql://app:app@localhost:5432/ocenka?schema=public"
# Случайная строка >= 32 символов
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Публичный адрес сервиса (для ссылок)
# Адрес для разработки. В продакшене канонический адрес — всегда https://evmo.ru
# (переопределить можно только переменной SITE_URL, например для тестового стенда).
APP_URL="http://localhost:3000"
# Яндекс Карты: HTTP Геокодер и API Поиска по организациям (ключ из Кабинета разработчика)
YANDEX_API_KEY=""
# Необязательно: отдельный ключ для API Поиска по организациям, если он выпущен отдельно
# YANDEX_SEARCH_API_KEY=""
# Необязательно: отдельный ключ JavaScript API Яндекс Карт для интерактивной карты (ограничьте по HTTP Referer)
# YANDEX_MAPS_JS_API_KEY=""
# Metrapi: объявления о продаже (поиск аналогов). Ключ — только на сервере.
METRAPI_API_KEY=""

# Почта для приглашений в команду (необязательно). Без SMTP приглашение создаётся,
# а ссылку администратор передаёт сотруднику сам. Отправитель по умолчанию — info@evmo.ru.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="ЭВМО <info@evmo.ru>"
