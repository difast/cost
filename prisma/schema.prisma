// Модель данных «Цифрового рабочего места оценщика».
// Принципы:
//  * справочники, коэффициенты, шаблоны и нормативка — данные, а не код;
//  * каждая значимая цифра имеет источник и дату (Source + provenance);
//  * расчёт воспроизводим: CalculationVersion хранит полный снимок входных данных.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Пользователи и организации

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String?
  role           String        @default("appraiser") // appraiser | admin
  plan           String        @default("trial")     // trial | basic | pro | team | corporate
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  appraiser      Appraiser?
  sessions       Session[]
  assessments    Assessment[]
  events         AssessmentEvent[]
  files          StoredFile[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  ogrn      String?
  kpp       String?
  address   String?
  users     User[]
  createdAt DateTime @default(now())
}

/// Постоянные данные оценщика, подставляются в каждый отчёт.
model Appraiser {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName               String    @default("")
  position               String?
  phone                  String?
  email                  String?
  postalAddress          String?
  education              String?
  experienceYears        Int?
  sroName                String?
  sroRegistryNumber      String?
  sroMembershipDate      DateTime?
  sroAddress             String?
  qualificationCertNumber String?
  qualificationCertDate  DateTime?
  qualificationCertValidUntil DateTime?
  qualificationArea      String?   @default("Оценка недвижимости")
  insuranceCompany       String?
  insurancePolicyNumber  String?
  insuranceSum           Decimal?  @db.Decimal(18, 2)
  insuranceValidFrom     DateTime?
  insuranceValidUntil    DateTime?
  // Юридическое лицо, с которым оценщик заключил трудовой договор (если есть)
  legalEntityName        String?
  legalEntityInn         String?
  legalEntityOgrn        String?
  legalEntityAddress     String?
  legalEntityInsuranceCompany String?
  legalEntityInsurancePolicy  String?
  legalEntityInsuranceSum     Decimal? @db.Decimal(18, 2)
  legalEntityInsuranceValidUntil DateTime?
  bankDetails            String?
  signatureFileId        String?
  updatedAt              DateTime  @updatedAt
}

// ───────────────────────────── Оценка

model Assessment {
  id                 String    @id @default(cuid())
  ownerId            String
  owner              User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  number             String
  status             String    @default("draft") // draft | in_progress | review | completed | archived
  propertyType       String    @default("apartment")
  approach           String    @default("comparative")
  // Задание на оценку
  customerName       String?
  customerDetails    String?
  basis              String?   // основание для проведения оценки
  contractNumber     String?
  contractDate       DateTime?
  purpose            String?   // цель оценки
  intendedUse        String?   // предполагаемое использование результата
  valueType          String?   @default("Рыночная стоимость")
  rightsAssessed     String?   @default("Право собственности")
  valuationDate      DateTime?
  inspectionDate     DateTime?
  reportDate         DateTime?
  assumptions        String?
  limitingConditions String?
  marketAnalysis     String?   // анализ рынка (текст оценщика)
  // Справочник корректировок (редакция), действующий для этой оценки
  adjustmentSourceId String?
  adjustmentSource   AdjustmentSource? @relation(fields: [adjustmentSourceId], references: [id])
  property           Property?
  building           Building?
  comparables        Comparable[]
  adjustments        Adjustment[]
  sources            Source[]
  marketData         MarketData[]
  calculation        Calculation?
  reports            Report[]
  events             AssessmentEvent[]
  files              StoredFile[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ownerId, updatedAt])
}

/// Объект оценки (квартира). provenance: { field: { sourceId, at, note } }
model Property {
  id               String     @id @default(cuid())
  assessmentId     String     @unique
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  objectType       String     @default("Квартира")
  address          String?
  fiasId           String?
  cadastralNumber  String?
  area             Decimal?   @db.Decimal(12, 2)
  livingArea       Decimal?   @db.Decimal(12, 2)
  kitchenArea      Decimal?   @db.Decimal(12, 2)
  purpose          String?    @default("Жилое")
  rights           String?    @default("Собственность")
  rightHolders     String?
  encumbrances     String?
  rooms            Int?
  floor            Int?
  ceilingHeight    Decimal?   @db.Decimal(5, 2)
  finishing        String?    // none | rough | whitebox | standard | improved | designer
  condition        String?    // состояние квартиры (текст)
  furniture        Boolean?
  balcony          String?
  bathroom         String?
  communications   String?
  metroName        String?
  metroDistanceM   Int?
  district         String?
  description      String?
  provenance       Json       @default("{}")
  updatedAt        DateTime   @updatedAt
}

/// Здание, в котором расположен объект (копия на уровне оценки — для воспроизводимости).
model Building {
  id              String     @id @default(cuid())
  assessmentId    String     @unique
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  cadastralNumber String?
  yearBuilt       Int?
  floors          Int?
  wallMaterial    String?    // panel | brick | monolith | monolith_brick | block | wood | other
  series          String?
  houseCondition  String?    // good | satisfactory | poor
  elevators       String?
  parking         String?
  overhaulYear    Int?
  description     String?
  provenance      Json       @default("{}")
  updatedAt       DateTime   @updatedAt
}

/// Рыночный аналог. Каждый аналог обязан иметь источник и дату получения.
model Comparable {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  position        Int        @default(0)
  included        Boolean    @default(true)
  sourceKind      String     @default("manual") // manual | import | provider:<code>
  sourceName      String?    // ЦИАН, Авито, Домклик, ...
  sourceUrl       String?
  retrievedAt     DateTime?
  offerDate       DateTime?
  address         String?
  price           Decimal    @db.Decimal(18, 2)
  area            Decimal    @db.Decimal(12, 2)
  rooms           Int?
  floor           Int?
  floors          Int?
  wallMaterial    String?
  yearBuilt       Int?
  finishing       String?
  furniture       Boolean?
  houseCondition  String?
  metroDistanceM  Int?
  rights          String?    @default("Собственность")
  description     String?
  attributes      Json       @default("{}")
  screenshotFileId String?
  adjustments     Adjustment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assessmentId, position])
}

/// Применённая к аналогу корректировка. Хранит предложенное системой и фактическое значение.
model Adjustment {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  comparableId    String
  comparable      Comparable @relation(fields: [comparableId], references: [id], onDelete: Cascade)
  factorCode      String
  factorName      String
  stage           Int        @default(2)
  sortOrder       Int        @default(0)
  subjectValue    String?
  comparableValue String?
  suggestedValue  Decimal?   @db.Decimal(10, 6) // доля: -0.05 = -5%
  value           Decimal    @db.Decimal(10, 6)
  minValue        Decimal?   @db.Decimal(10, 6)
  maxValue        Decimal?   @db.Decimal(10, 6)
  overridden      Boolean    @default(false)
  comment         String?
  ruleSnapshot    Json?      // снимок правила справочника на момент применения
  updatedAt       DateTime   @updatedAt

  @@unique([comparableId, factorCode])
}

// ───────────────────────────── Справочник корректировок (версионный)

/// Редакция справочника: источник → редакция → дата актуальности → лицензия.
model AdjustmentSource {
  id           String    @id @default(cuid())
  code         String
  name         String
  publisher    String?
  edition      String
  actualDate   DateTime?
  segment      String    @default("apartment")
  licenseType  String    @default("own") // own | licensed | public | demo
  licenseNote  String?
  url          String?
  isDemo       Boolean   @default(false)
  isActive     Boolean   @default(true)
  ownerId      String?   // null — системный справочник
  factors      AdjustmentFactor[]
  assessments  Assessment[]
  createdAt    DateTime  @default(now())

  @@unique([code, edition])
}

/// Показатель (фактор) в редакции справочника.
/// kind: discount | category | power | manual
model AdjustmentFactor {
  id          String           @id @default(cuid())
  sourceId    String
  source      AdjustmentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  kind        String
  attribute   String?          // извлекаемый признак: floor_category, wall_material, finishing, furniture, house_condition, metro_distance, area
  stage       Int              @default(2)
  sortOrder   Int              @default(0)
  value       Decimal?         @db.Decimal(10, 6) // для discount
  minValue    Decimal?         @db.Decimal(10, 6)
  maxValue    Decimal?         @db.Decimal(10, 6)
  params      Json             @default("{}")    // для power: { exponent }, для metro: { buckets }
  reference   String?          // таблица/страница источника
  description String?
  enabled     Boolean          @default(true)
  categories  AdjustmentCategory[]

  @@unique([sourceId, code])
}

/// Категория показателя с относительным коэффициентом. Корректировка = k(объект)/k(аналог) − 1.
model AdjustmentCategory {
  id          String           @id @default(cuid())
  factorId    String
  factor      AdjustmentFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
  code        String
  label       String
  coefficient Decimal          @db.Decimal(10, 6)
  minCoefficient Decimal?      @db.Decimal(10, 6)
  maxCoefficient Decimal?      @db.Decimal(10, 6)
  sortOrder   Int              @default(0)

  @@unique([factorId, code])
}

// ───────────────────────────── Источники, рынок, файлы

/// Источник данных (выписка ЕГРН, ручной ввод, URL, поставщик данных).
model Source {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         String     // egrn_xml | egrn_pdf | manual | url | provider | user_import
  title        String
  url          String?
  retrievedAt  DateTime   @default(now())
  fileId       String?
  extracted    Json?      // данные, извлечённые из источника (для сверки)
  note         String?
  createdAt    DateTime   @default(now())
}

model MarketData {
  id           String     @id @default(cuid())
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  region       String?
  segment      String?
  indicator    String
  value        Decimal    @db.Decimal(18, 4)
  unit         String?
  period       String?
  sourceTitle  String
  sourceUrl    String?
  retrievedAt  DateTime   @default(now())
}

model StoredFile {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         String      // photo | screenshot | egrn | signature | report | other
  filename     String
  mime         String
  size         Int
  sha256       String
  data         Bytes
  caption      String?
  createdAt    DateTime    @default(now())
}

// ───────────────────────────── Нормативная база

model NormativeDocument {
  id            String    @id @default(cuid())
  kind          String    // law | fso | sro_standard | methodology | court | literature
  code          String?   // 135-ФЗ, ФСО I ...
  title         String
  issuer        String?
  adoptedAt     DateTime?
  effectiveFrom DateTime?
  status        String    @default("active") // active | repealed | draft
  url           String?
  summary       String?
  body          String?
  tags          String[]  @default([])
  licenseNote   String?
  revision      Int       @default(1)
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────────── Расчёт и отчёт

model Calculation {
  id              String      @id @default(cuid())
  assessmentId    String      @unique
  assessment      Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  settings        Json        @default("{}")
  versions        CalculationVersion[]
  updatedAt       DateTime    @updatedAt
}

/// Зафиксированная версия расчёта: полный снимок входа + результат + хэш.
model CalculationVersion {
  id             String      @id @default(cuid())
  calculationId  String
  calculation    Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  versionNumber  Int
  engineVersion  String
  inputHash      String
  snapshot       Json
  result         Json
  createdById    String?
  note           String?
  reports        Report[]
  createdAt      DateTime    @default(now())

  @@unique([calculationId, versionNumber])
}

model ReportTemplate {
  id           String   @id @default(cuid())
  code         String
  version      Int
  name         String
  propertyType String   @default("apartment")
  approach     String   @default("comparative")
  definition   Json
  isActive     Boolean  @default(true)
  reports      Report[]
  createdAt    DateTime @default(now())

  @@unique([code, version])
}

model Report {
  id                   String             @id @default(cuid())
  assessmentId         String
  assessment           Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  calculationVersionId String
  calculationVersion   CalculationVersion @relation(fields: [calculationVersionId], references: [id])
  templateId           String
  template             ReportTemplate     @relation(fields: [templateId], references: [id])
  format               String             // docx | pdf
  fileId               String
  checks               Json
  createdById          String?
  createdAt            DateTime           @default(now())
}

/// Журнал изменений оценки.
model AssessmentEvent {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String     // create | update | delete | calculate | report | import
  entity       String     // assessment | property | building | comparable | adjustment | calculation | report | source
  entityId     String?
  summary      String
  diff         Json?
  createdAt    DateTime   @default(now())

  @@index([assessmentId, createdAt])
}
