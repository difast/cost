// Модель данных «Цифрового рабочего места оценщика».
// Принципы:
//  * справочники, коэффициенты, шаблоны и нормативка — данные, а не код;
//  * каждая значимая цифра имеет источник и дату (Source + provenance);
//  * расчёт воспроизводим: CalculationVersion хранит полный снимок входных данных.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Пользователи и организации

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  name           String?
  role           String            @default("appraiser") // appraiser | admin
  /// Устарело: тариф хранится в подписке рабочего пространства (Subscription). Поле не используется.
  plan           String            @default("trial")
  /// Текущее рабочее пространство (если пользователь состоит в нескольких)
  currentWorkspaceId String?
  memberships    WorkspaceMember[]
  ownedWorkspaces Workspace[]      @relation("WorkspaceOwner")
  invitationsSent Invitation[]     @relation("InvitedBy")
  /// Системные настройки пользователя: умолчания для новых оценок и пороги контроля.
  settings       Json              @default("{}")
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  appraiser      Appraiser?
  sessions       Session[]
  assessments    Assessment[]
  events         AssessmentEvent[]
  files          StoredFile[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ───────────────────────────── Рабочие пространства, тарифы, приглашения
// Рабочее пространство → участники (роль) → подписка (тариф, пробный период, статус оплаты).

model Workspace {
  id           String            @id @default(cuid())
  name         String
  ownerId      String
  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  subscription Subscription?
  invitations  Invitation[]
  assessments  Assessment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | admin | member
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Подписка рабочего пространства. Пробный период — обычный тариф + даты trial, а не отдельный тариф.
model Subscription {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// basic | pro | team | corporate
  planCode           String    @default("basic")
  /// trialing | active | past_due | canceled | expired
  status             String    @default("trialing")
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// none | pending | paid | failed — заполняется платёжной системой (пока не подключена)
  paymentStatus      String    @default("none")
  /// Поставщик платежей и идентификатор подписки у него (для будущего биллинга)
  provider           String?
  providerRef        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  /// admin | member
  role        String    @default("member")
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  /// pending | accepted | revoked
  status      String    @default("pending")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, email])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  ogrn      String?
  kpp       String?
  address   String?
  users     User[]
  createdAt DateTime @default(now())
}

/// Постоянные данные оценщика, подставляются в каждый отчёт.
model Appraiser {
  id                             String    @id @default(cuid())
  userId                         String    @unique
  user                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                       String    @default("")
  position                       String?
  phone                          String?
  email                          String?
  postalAddress                  String?
  education                      String?
  experienceYears                Int?
  sroName                        String?
  sroRegistryNumber              String?
  sroMembershipDate              DateTime?
  sroAddress                     String?
  qualificationCertNumber        String?
  qualificationCertDate          DateTime?
  qualificationCertValidUntil    DateTime?
  qualificationArea              String?   @default("Оценка недвижимости")
  insuranceCompany               String?
  insurancePolicyNumber          String?
  insuranceSum                   Decimal?  @db.Decimal(18, 2)
  insuranceValidFrom             DateTime?
  insuranceValidUntil            DateTime?
  // Юридическое лицо, с которым оценщик заключил трудовой договор (если есть)
  legalEntityName                String?
  legalEntityInn                 String?
  legalEntityOgrn                String?
  legalEntityAddress             String?
  legalEntityInsuranceCompany    String?
  legalEntityInsurancePolicy     String?
  legalEntityInsuranceSum        Decimal?  @db.Decimal(18, 2)
  legalEntityInsuranceValidUntil DateTime?
  bankDetails                    String?
  signatureFileId                String?
  updatedAt                      DateTime  @updatedAt
}

// ───────────────────────────── Оценка

model Assessment {
  id                 String                  @id @default(cuid())
  /// Автор оценки (создатель)
  ownerId            String
  owner              User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Рабочее пространство: оценки доступны его участникам согласно ролям
  workspaceId        String
  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  number             String
  status             String                  @default("draft") // draft | in_progress | review | completed | archived
  propertyType       String                  @default("apartment")
  approach           String                  @default("comparative")
  // Задание на оценку
  customerName       String?
  customerDetails    String?
  basis              String? // основание для проведения оценки
  contractNumber     String?
  contractDate       DateTime?
  purpose            String? // цель оценки
  intendedUse        String? // предполагаемое использование результата
  valueType          String?                 @default("Рыночная стоимость")
  rightsAssessed     String?                 @default("Право собственности")
  valuationDate      DateTime?
  inspectionDate     DateTime?
  reportDate         DateTime?
  assumptions        String?
  limitingConditions String?
  marketAnalysis     String? // анализ рынка (текст оценщика)
  // Справочник корректировок (редакция), действующий для этой оценки
  adjustmentSourceId String?
  adjustmentSource   AdjustmentSource?       @relation(fields: [adjustmentSourceId], references: [id])
  property           Property?
  building           Building?
  comparables        Comparable[]
  adjustments        Adjustment[]
  sources            Source[]
  marketData         MarketData[]
  calculation        Calculation?
  listingSearches    ListingSearch[]
  reports            Report[]
  reportDocument     ReportDocument?
  reportVersions     ReportDocumentVersion[]
  events             AssessmentEvent[]
  files              StoredFile[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([ownerId, updatedAt])
  @@index([workspaceId, updatedAt])
}

/// Объект оценки (квартира). provenance: { field: { sourceId, at, note } }
model Property {
  id              String     @id @default(cuid())
  assessmentId    String     @unique
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  objectType      String     @default("Квартира")
  address         String?
  fiasId          String?
  /// Нормализованный адрес: регион, населённый пункт, улица, дом, идентификаторы ГАР, источник
  addressDetails  Json?
  cadastralNumber String?
  area            Decimal?   @db.Decimal(12, 2)
  livingArea      Decimal?   @db.Decimal(12, 2)
  kitchenArea     Decimal?   @db.Decimal(12, 2)
  purpose         String?    @default("Жилое")
  rights          String?    @default("Собственность")
  rightHolders    String?
  encumbrances    String?
  rooms           Int?
  floor           Int?
  ceilingHeight   Decimal?   @db.Decimal(5, 2)
  finishing       String? // none | rough | whitebox | standard | improved | designer
  condition       String? // состояние квартиры (текст)
  furniture       Boolean?
  balcony         String?
  bathroom        String?
  communications  String?
  metroName       String?
  metroDistanceM  Int?
  district        String?
  description     String?
  /// Координаты объекта (WGS 84). Источник — в provenance (геокодер или ручной ввод).
  latitude        Decimal?   @db.Decimal(9, 6)
  longitude       Decimal?   @db.Decimal(9, 6)
  /// Снимок ближайшей инфраструктуры, полученной из картографического сервиса (для отчёта).
  infrastructure  Json?
  provenance      Json       @default("{}")
  updatedAt       DateTime   @updatedAt
}

/// Здание, в котором расположен объект (копия на уровне оценки — для воспроизводимости).
model Building {
  id              String     @id @default(cuid())
  assessmentId    String     @unique
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  cadastralNumber String?
  yearBuilt       Int?
  floors          Int?
  wallMaterial    String? // panel | brick | monolith | monolith_brick | block | wood | other
  series          String?
  houseCondition  String? // good | satisfactory | poor
  elevators       String?
  parking         String?
  overhaulYear    Int?
  description     String?
  provenance      Json       @default("{}")
  updatedAt       DateTime   @updatedAt
}

/// Рыночный аналог. Каждый аналог обязан иметь источник и дату получения.
model Comparable {
  id               String       @id @default(cuid())
  assessmentId     String
  assessment       Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  position         Int          @default(0)
  included         Boolean      @default(true)
  sourceKind       String       @default("manual") // manual | import | provider:<code>
  sourceName       String? // ЦИАН, Авито, Домклик, ...
  sourceUrl        String?
  retrievedAt      DateTime?
  offerDate        DateTime?
  address          String?
  price            Decimal      @db.Decimal(18, 2)
  area             Decimal      @db.Decimal(12, 2)
  rooms            Int?
  floor            Int?
  floors           Int?
  wallMaterial     String?
  yearBuilt        Int?
  finishing        String?
  furniture        Boolean?
  houseCondition   String?
  metroDistanceM   Int?
  rights           String?      @default("Собственность")
  description      String?
  attributes       Json         @default("{}")
  screenshotFileId String?
  /// Статус в оценке: use — используется в расчёте, review — на проверке, exclude — не используется.
  /// included синхронизирован со статусом (included = status === "use").
  status           String       @default("use")
  /// Внешний источник: код поставщика и идентификатор объявления у него.
  provider         String?
  externalId       String?
  houseType        String?
  region           String?
  city             String?
  district         String?
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @db.Decimal(9, 6)
  /// Расстояние по прямой до объекта оценки, м (пересчитывается при изменении координат).
  distanceM        Int?
  photoUrl         String?
  /// Дата обновления объявления у источника.
  sourceUpdatedAt  DateTime?
  /// Исходные данные объявления в том виде, как их вернул источник, и нормализованная копия
  /// на момент включения в оценку. Не меняются при повторных запросах к API.
  rawData          Json?
  normalized       Json?
  /// Источник каждого поля (как у объекта): { field: { source, title, at } }.
  provenance       Json         @default("{}")
  adjustments      Adjustment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([assessmentId, position])
  @@index([assessmentId, provider, externalId])
}

/// Применённая к аналогу корректировка. Хранит предложенное системой и фактическое значение.
model Adjustment {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  comparableId    String
  comparable      Comparable @relation(fields: [comparableId], references: [id], onDelete: Cascade)
  factorCode      String
  factorName      String
  stage           Int        @default(2)
  sortOrder       Int        @default(0)
  subjectValue    String?
  comparableValue String?
  suggestedValue  Decimal?   @db.Decimal(10, 6) // доля: -0.05 = -5%
  value           Decimal    @db.Decimal(10, 6)
  minValue        Decimal?   @db.Decimal(10, 6)
  maxValue        Decimal?   @db.Decimal(10, 6)
  overridden      Boolean    @default(false)
  comment         String?
  /// Кто и когда изменил значение вручную; характеристики объекта и аналога на тот момент.
  overriddenById  String?
  overriddenAt    DateTime?
  basisSnapshot   Json?
  /// Фактор справочника признан неприменимым к аналогу (обоснование — в comment).
  notRequired     Boolean    @default(false)
  ruleSnapshot    Json? // снимок правила справочника на момент применения
  updatedAt       DateTime   @updatedAt

  @@unique([comparableId, factorCode])
}

// ───────────────────────────── Справочник корректировок (версионный)

/// Редакция справочника: источник → редакция → дата актуальности → лицензия.
model AdjustmentSource {
  id          String             @id @default(cuid())
  code        String
  name        String
  publisher   String?
  edition     String
  actualDate  DateTime?
  segment     String             @default("apartment")
  licenseType String             @default("own") // own | licensed | public | demo
  licenseNote String?
  url         String?
  isDemo      Boolean            @default(false)
  isActive    Boolean            @default(true)
  ownerId     String? // null — системный справочник
  factors     AdjustmentFactor[]
  assessments Assessment[]
  createdAt   DateTime           @default(now())

  @@unique([code, edition])
}

/// Показатель (фактор) в редакции справочника.
/// kind: discount | category | power | manual
model AdjustmentFactor {
  id          String               @id @default(cuid())
  sourceId    String
  source      AdjustmentSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  kind        String
  attribute   String? // извлекаемый признак: floor_category, wall_material, finishing, furniture, house_condition, metro_distance, area
  stage       Int                  @default(2)
  sortOrder   Int                  @default(0)
  value       Decimal?             @db.Decimal(10, 6) // для discount
  minValue    Decimal?             @db.Decimal(10, 6)
  maxValue    Decimal?             @db.Decimal(10, 6)
  params      Json                 @default("{}") // для power: { exponent }, для metro: { buckets }
  reference   String? // таблица/страница источника
  description String?
  /// Группа фактора: условия сделки, местоположение, физические характеристики…
  groupName   String?
  /// Регион или группа регионов, к которым относятся значения.
  region      String?
  /// Методика определения значения.
  methodology String?
  comment     String?
  /// Дата актуальности значений фактора (если отличается от даты редакции).
  actualDate  DateTime?
  enabled     Boolean              @default(true)
  categories  AdjustmentCategory[]

  @@unique([sourceId, code])
}

/// Категория показателя с относительным коэффициентом. Корректировка = k(объект)/k(аналог) − 1.
model AdjustmentCategory {
  id             String           @id @default(cuid())
  factorId       String
  factor         AdjustmentFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
  code           String
  label          String
  coefficient    Decimal          @db.Decimal(10, 6)
  minCoefficient Decimal?         @db.Decimal(10, 6)
  maxCoefficient Decimal?         @db.Decimal(10, 6)
  sortOrder      Int              @default(0)

  @@unique([factorId, code])
}

// ───────────────────────────── Источники, рынок, файлы

/// Источник данных (выписка ЕГРН, ручной ввод, URL, поставщик данных).
model Source {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         String // egrn_xml | egrn_pdf | manual | url | provider | user_import
  title        String
  url          String?
  retrievedAt  DateTime   @default(now())
  fileId       String?
  extracted    Json? // данные, извлечённые из источника (для сверки)
  note         String?
  createdAt    DateTime   @default(now())
}

model MarketData {
  id           String      @id @default(cuid())
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  region       String?
  segment      String?
  indicator    String
  value        Decimal     @db.Decimal(18, 4)
  unit         String?
  period       String?
  sourceTitle  String
  sourceUrl    String?
  retrievedAt  DateTime    @default(now())
}

model StoredFile {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kind         String // photo | screenshot | egrn | signature | report | other
  filename     String
  mime         String
  size         Int
  sha256       String
  data         Bytes
  caption      String?
  createdAt    DateTime    @default(now())
}

// ───────────────────────────── Нормативная база

model NormativeDocument {
  id            String    @id @default(cuid())
  kind          String // law | fso | sro_standard | methodology | court | literature
  code          String? // 135-ФЗ, ФСО I ...
  title         String
  issuer        String?
  adoptedAt     DateTime?
  effectiveFrom DateTime?
  status        String    @default("active") // active | repealed | draft
  url           String?
  summary       String?
  body          String?
  tags          String[]  @default([])
  licenseNote   String?
  revision      Int       @default(1)
  updatedAt     DateTime  @updatedAt
}

// ───────────────────────────── Расчёт и отчёт

model Calculation {
  id           String               @id @default(cuid())
  assessmentId String               @unique
  assessment   Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  settings     Json                 @default("{}")
  /// Состояние контроля качества: замечания, которые были и исправлены (статус «Исправлено»)
  qualityState Json                 @default("{}")
  versions     CalculationVersion[]
  updatedAt    DateTime             @updatedAt
}

/// Зафиксированная версия расчёта: полный снимок входа + результат + хэш.
model CalculationVersion {
  id               String                  @id @default(cuid())
  calculationId    String
  calculation      Calculation             @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  versionNumber    Int
  engineVersion    String
  inputHash        String
  snapshot         Json
  result           Json
  createdById      String?
  note             String?
  reports          Report[]
  documentVersions ReportDocumentVersion[]
  createdAt        DateTime                @default(now())

  @@unique([calculationId, versionNumber])
}

model ReportTemplate {
  id           String   @id @default(cuid())
  code         String
  version      Int
  name         String
  propertyType String   @default("apartment")
  approach     String   @default("comparative")
  definition   Json
  isActive     Boolean  @default(true)
  reports      Report[]
  createdAt    DateTime @default(now())

  @@unique([code, version])
}

model Report {
  id                   String             @id @default(cuid())
  assessmentId         String
  assessment           Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  calculationVersionId String
  calculationVersion   CalculationVersion @relation(fields: [calculationVersionId], references: [id])
  templateId           String
  template             ReportTemplate     @relation(fields: [templateId], references: [id])
  format               String // docx | pdf | xlsx
  fileId               String
  /// Версия рабочего документа, из которой сформирован файл (null — отчёт по шаблону без документа).
  documentVersionId    String?
  checks               Json
  createdById          String?
  createdAt            DateTime           @default(now())
}

/// Журнал изменений оценки.
model AssessmentEvent {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String // create | update | delete | calculate | report | import
  entity       String // assessment | property | building | comparable | adjustment | calculation | report | source
  entityId     String?
  summary      String
  diff         Json?
  createdAt    DateTime   @default(now())

  @@index([assessmentId, createdAt])
}

/// Результат поиска объявлений у внешнего поставщика (нормализованные данные, кэш).
model ListingSearch {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  provider     String
  queryHash    String
  query        Json
  total        Int?
  /// Нормализованные объявления (ограниченное количество), исходные данные — в raw каждого элемента.
  results      Json
  createdAt    DateTime   @default(now())
  expiresAt    DateTime

  @@index([assessmentId, createdAt])
  @@index([provider, queryHash])
}

// ───────────── ГАР (ФИАС): только данные, нужные для поиска адресов

/// Журнал потокового импорта ГАР.
model GarImport {
  id         String    @id @default(cuid())
  archive    String
  region     String?
  stage      String
  status     String    @default("running") // running | done | failed
  rows       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

/// Адресообразующие элементы (AS_ADDR_OBJ): регион, муниципальное образование, населённый пункт, улица.
model GarAddrObj {
  objectId   BigInt @id
  guid       String
  name       String
  typeName   String
  level      Int
  regionCode Int

  @@index([regionCode, level])
}

/// Дома (AS_HOUSES).
model GarHouse {
  objectId   BigInt  @id
  guid       String
  houseNum   String?
  addNum1    String?
  addNum2    String?
  houseType  Int?
  addType1   Int?
  addType2   Int?
  /// Номер дома с типами из справочников ГАР (AS_HOUSE_TYPES, AS_ADDHOUSE_TYPES): «д. 12, корп. 1».
  label      String?
  regionCode Int

  @@index([regionCode])
}

/// Муниципальная иерархия (AS_MUN_HIERARCHY): путь от региона до объекта.
model GarHierarchy {
  objectId    BigInt  @id
  parentObjId BigInt?
  path        String
  oktmo       String?
  regionCode  Int

  @@index([regionCode])
}

/// Плоский справочник адресов домов для поиска (строится из трёх таблиц выше).
/// Индексы GarAddress_normalized_fts_idx (GIN) и GarAddress_normalized_prefix_idx созданы в миграции вручную —
/// при генерации новых миграций удаляйте из них строки DROP INDEX для этих индексов.
model GarAddress {
  objectId     BigInt  @id
  guid         String  @unique
  regionCode   Int
  region       String?
  municipality String?
  locality     String?
  street       String?
  house        String?
  fullAddress  String
  normalized   String

  @@index([regionCode])
  @@index([municipality])
  @@index([locality])
  @@index([street])
  @@index([house])
}

// ───────────── Росстат: территориальный и рыночный контекст

/// Загруженный файл Росстата и результат анализа его структуры.
model RosstatFile {
  id         String         @id @default(cuid())
  fileName   String
  sha256     String         @unique
  format     String
  sizeBytes  BigInt
  /// Обнаруженная структура (листы, заголовки, примеры строк) — основа для настройки импорта.
  structure  Json
  status     String         @default("analyzed") // analyzed | imported | failed
  rows       Int            @default(0)
  importedAt DateTime?
  createdAt  DateTime       @default(now())
  values     RosstatValue[]
}

/// Показатель Росстата.
model RosstatSeries {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  unit     String?
  /// secondary_prices | price_index | incomes | housing_construction | other
  category String
  source   String
  values   RosstatValue[]
}

model RosstatValue {
  id          String        @id @default(cuid())
  seriesId    String
  series      RosstatSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  regionCode  String?
  regionName  String
  period      String
  periodStart DateTime
  value       Decimal       @db.Decimal(20, 6)
  fileId      String
  file        RosstatFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  actualDate  DateTime?

  @@unique([seriesId, regionName, period])
  @@index([regionName, period])
}

/// Рабочий документ отчёта (один на оценку): структура, ручные правки, статус.
/// Автоматические данные не копируются — подставляются из оценки при каждом открытии.
model ReportDocument {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// draft | review | approved | final
  status       String     @default("draft")
  content      Json
  updatedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Зафиксированная версия отчёта: документ, подтверждённый расчёт и файлы DOCX/PDF/XLSX из одного снимка.
model ReportDocumentVersion {
  id                   String             @id @default(cuid())
  assessmentId         String
  assessment           Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  versionNumber        Int
  /// Статус документа на момент фиксации: review | approved | final
  status               String
  calculationVersionId String
  calculationVersion   CalculationVersion @relation(fields: [calculationVersionId], references: [id])
  /// Структура и правки документа на момент фиксации
  content              Json
  /// Итоговая модель документа (ReportDoc), из которой построены все файлы
  rendered             Json
  docxFileId           String?
  pdfFileId            String?
  xlsxFileId           String?
  note                 String?
  createdById          String?
  createdAt            DateTime           @default(now())

  @@unique([assessmentId, versionNumber])
}
