{
  "name": "ocenka-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Цифровое рабочее место оценщика недвижимости",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:prod": "prisma migrate deploy && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "gar:import": "node scripts/gar/import.mjs",
    "rosstat:analyze": "node scripts/rosstat/analyze.mjs",
    "rosstat:import": "node scripts/rosstat/import.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.27",
    "nodemailer": "^6.10.1",
    "pdfmake": "^0.3.11",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
